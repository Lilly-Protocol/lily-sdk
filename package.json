{
  "name": "@lily-protocol/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for integrating Lily Protocol agent finance infrastructure into Node.js applications.",
  "keywords": [
    "lily",
    "lily-protocol",
    "stellar",
    "sdk",
    "typescript",
    "agents",
    "payments",
    "wallet"
  ],
  "homepage": "https://github.com/Lilly-Protocol/lily-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lilly-Protocol/lily-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Lilly-Protocol/lily-sdk/issues"
  },
  "license": "MIT",
  "author": "Lily Protocol",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "require": "./dist/http.cjs"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js",
      "require": "./dist/models.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist coverage .turbo",
    "prebuild": "bash scripts/generate-version.sh",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.examples.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "example": "tsx examples/quickstart.ts",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "docs": "typedoc --out docs/api --tsconfig tsconfig.docs.json --entryPoints src/index.ts src/config.ts src/errors.ts src/http.ts src/models.ts src/types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^24.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typedoc": "^0.28.20",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.2.4"
  }
}
